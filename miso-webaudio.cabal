cabal-version:      3.0
name:               miso-webaudio
version:            0.1.0.0
synopsis:           Web Audio for miso
description:        Typed bindings to the Web Audio graph.
homepage:           https://github.com/haskell-miso/webaudio
license:            BSD-3-Clause
license-file:       LICENSE
author:             IC Rainbow
maintainer:         aenor.realm@gmail.com
category:           Web, Sound
build-type:         Simple
extra-doc-files:    CHANGELOG.md, README.md

source-repository head
  type:     git
  location: https://github.com/haskell-miso/webaudio.git

common warnings
  ghc-options:
    -ferror-spans -Wall

common language
  default-language:
    GHC2021
  default-extensions:
    LambdaCase
    OverloadedStrings

common wasm
  if arch(wasm32)
    ghc-options:
      -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_start"
    cpp-options:
      -DWASM

common js
  if arch(javascript)
    ld-options:
      -sEXPORTED_RUNTIME_METHODS=HEAP8

library
  import:
    language, warnings
  exposed-modules:
    Miso.WebAudio
    Miso.WebAudio.Analyser
    Miso.WebAudio.Buffer
    Miso.WebAudio.Channel
    Miso.WebAudio.Context
    Miso.WebAudio.Filter
    Miso.WebAudio.Media
    Miso.WebAudio.Node
    Miso.WebAudio.Note
    Miso.WebAudio.Param
    Miso.WebAudio.Player
    Miso.WebAudio.Source
    Miso.WebAudio.Spatial
    Miso.WebAudio.Stats
    Miso.WebAudio.Types
    Miso.WebAudio.Worklet
  other-modules:
    Miso.WebAudio.Internal
  hs-source-dirs:
    src
  build-depends:
    base < 5, miso >= 1.14 && < 1.16

executable webaudio-check
  import:
    language, warnings, wasm, js
  main-is:
    Main.hs
  hs-source-dirs:
    test/browser
  build-depends:
    base, miso, miso-webaudio
  if !(arch(javascript) || arch(wasm32))
    buildable: False
